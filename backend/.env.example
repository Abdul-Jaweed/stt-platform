# Copy to .env and adjust. All variables are prefixed STT_.
STT_DATABASE_URL=postgresql+psycopg://stt:stt@127.0.0.1:25432/stt
# Optional overrides (defaults resolve inside the repository):
# STT_MODEL_DIR=I:/voice-agent-course/local-stt/models/faster-whisper
# STT_HF_HOME=I:/voice-agent-course/local-stt/models/huggingface
# STT_WHISPER_MODEL=large-v3-turbo
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
# STT_MAX_UPLOAD_BYTES=104857600
# STT_MAX_SYNC_DURATION_S=180
# S3-compatible object storage (RustFS in dev):
# STT_S3_ENDPOINT=http://127.0.0.1:29000
# STT_S3_ACCESS_KEY=stt
# STT_S3_SECRET_KEY=stt123456
# STT_S3_BUCKET_AUDIO=stt-audio
# STT_S3_BUCKET_ARTIFACTS=stt-artifacts
# Managed providers — a provider registers only when its key is set.
# Keys are never logged, never committed, never sent to the frontend.
# STT_DEEPGRAM_API_KEY=
# STT_DEEPGRAM_BASE_URL=https://api.deepgram.com
# STT_ELEVENLABS_API_KEY=
# STT_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# STT_ELEVENLABS_MODEL_ID=scribe_v2
# STT_SARVAM_API_KEY=
# STT_SARVAM_BASE_URL=https://api.sarvam.ai
# STT_MANAGED_CONCURRENCY=4
# STT_GPU_CONCURRENCY=1

# Observability (Phase 5) — off by default: no exporters, no network, no
# overhead. Turning it on must never break a transcription.
# STT_OTEL_ENABLED=false
# STT_OTEL_EXPORTER=otlp            # otlp | console | none
# STT_OTEL_ENDPOINT=http://127.0.0.1:4318
# STT_OTEL_SERVICE_NAME=stt-platform
# STT_OTEL_ENVIRONMENT=local
# STT_OTEL_SAMPLE_RATIO=1.0
# STT_LOG_JSON=false                # one redacted JSON object per line
# STT_LOG_LEVEL=INFO
# STT_PROMETHEUS_ENABLED=false      # serve /metrics for scraping
# STT_PROMETHEUS_PORT=9464

# --- Security (Phase 7) -----------------------------------------------------
# Auth is off for the local developer flow; turn it on and every /v1 request
# must present X-API-Key. The key's tenant — never the request — sets the scope.
STT_AUTH_ENABLED=false
# tenant:key pairs, comma separated. Keys must never be committed.
STT_API_KEYS=
# Per-tenant request quota for the transcriptions API (0 = disabled).
STT_MAX_REQUESTS_PER_MINUTE=0
# Retention window for the purge tool (0 = keep everything).
STT_RETENTION_DAYS=0
