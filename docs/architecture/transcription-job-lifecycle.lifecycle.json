  "transitions": [
    { "from": "accepted", "to": "validating" },
    { "from": "validating", "to": "stored", "label": "checks pass" },
    { "from": "validating", "to": "failed", "label": "content rejected", "variant": "security" },
    { "from": "stored", "to": "queued", "label": "outbox row written" },
    { "from": "stored", "to": "failed", "label": "storage unavailable", "variant": "security" },
    { "from": "queued", "to": "processing", "label": "row claimed" },
    { "from": "queued", "to": "cancelled", "label": "direct cancel", "variant": "security" },
    { "from": "processing", "to": "succeeded", "label": "result stored", "variant": "emphasis" },
    { "from": "processing", "to": "retry_wait", "label": "retryable error" },
    { "from": "processing", "to": "failed", "label": "permanent · exhausted", "variant": "security" },
    { "from": "processing", "to": "cancelled", "label": "cancel via Temporal", "variant": "security" },
    { "from": "retry_wait", "to": "queued", "label": "backoff elapsed", "variant": "dashed" },
    { "from": "retry_wait", "to": "failed", "variant": "security" },
    { "from": "retry_wait", "to": "cancelled", "variant": "security" },
    { "from": "failed", "to": "queued", "label": "manual retry", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "One source of truth", "items": [
      "ALLOWED_TRANSITIONS in domain/status.py decides what is legal; PostgreSQL stores every transition that happens",
      "An illegal transition raises INVALID_TRANSITION instead of writing a row",
      "PARTIALLY_SUCCEEDED is deliberately absent until its semantics are defined (spec §9)"
    ] },
    { "dot": "amber", "title": "Every attempt is visible", "items": [
      "Retries run inside the workflow rather than Temporal's activity RetryPolicy, so each failure writes a RETRY_WAIT row",
      "Backoff is bounded: 2s × 2^(n-1), capped at 60s, plus 25% jitter drawn from workflow.random() so replays are deterministic",
      "The attempt budget (max_attempts, default 3) and the per-attempt timeout are settings, not constants"
    ] },
    { "dot": "rose", "title": "Terminal and recovery exits", "items": [
      "SUCCEEDED and CANCELLED have no outgoing transitions",
      "FAILED can be requeued manually, which is why it is not a dead end",
      "A cancel delivered while sleeping or while an activity is pending ends as CANCELLED, never as a retry"
    ] }
  ]
}
