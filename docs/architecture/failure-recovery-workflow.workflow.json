  "cards": [
    {
      "dot": "cyan",
      "title": "Bounded by design",
      "items": [
        "max_attempts defaults to 3; each attempt is a one-shot Temporal activity, because retries live in the workflow itself",
        "Backoff is 2s × 2^(n-1) capped at 60s with 25% jitter, drawn from workflow.random() so replays stay deterministic",
        "The per-attempt timeout and the poll budget (poll_interval_s, max_wait_s) are settings, not constants"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recovery guarantees",
      "items": [
        "A provider submission is durable in provider_attempts, so a worker crash resumes polling instead of resubmitting",
        "Transport-level poll errors keep polling — the remote job may still be healthy",
        "A provider-side failure ends the attempt carrying the provider's own retryability verdict"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest failure",
      "items": [
        "Permanent errors fail the job immediately; retryable ones spend the attempt budget",
        "A cancel arriving while the workflow sleeps or awaits an activity ends it as CANCELLED, not as a retry",
        "A best-effort cancel_remote that fails is logged and never masks the cancellation itself"
      ]
    }
  ]
