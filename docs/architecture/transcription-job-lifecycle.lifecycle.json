    { "id": "validating", "type": "active", "label": "VALIDATING", "sublabel": "content + limits", "lane": "main", "col": 1, "step": "02", "tag": "ffprobe",
      "sources": [{ "path": "backend/src/stt_platform/audio/validation.py", "line": 9, "end_line": 38, "label": "validate_upload" }] },
    { "id": "stored", "type": "active", "label": "STORED", "sublabel": "object written", "lane": "main", "col": 2, "step": "03", "tag": "opaque key",
      "sources": [{ "path": "backend/src/stt_platform/domain/status.py", "line": 22, "end_line": 25, "label": "allowed transitions" }] },
    { "id": "queued", "type": "waiting", "label": "QUEUED", "sublabel": "outbox row pending", "lane": "main", "col": 3, "step": "04", "tag": "not yet running",
      "sources": [{ "path": "backend/src/stt_platform/persistence/outbox.py", "line": 52, "end_line": 69, "label": "SKIP LOCKED claim" }] },
    { "id": "processing", "type": "active", "label": "PROCESSING", "sublabel": "attempt in flight", "lane": "main", "col": 4, "step": "05", "tag": "workflow attempt",
