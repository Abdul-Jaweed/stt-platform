# Copy to .env and adjust. All variables are prefixed STT_.
STT_DATABASE_URL=postgresql+psycopg://stt:stt@127.0.0.1:25432/stt
# Optional overrides (defaults resolve inside the repository):
# STT_MODEL_DIR=I:/voice-agent-course/local-stt/models/faster-whisper
# STT_HF_HOME=I:/voice-agent-course/local-stt/models/huggingface
# STT_WHISPER_MODEL=large-v3-turbo
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
# STT_MAX_UPLOAD_BYTES=104857600
# STT_MAX_SYNC_DURATION_S=180
# S3-compatible object storage (RustFS in dev):
# STT_S3_ENDPOINT=http://127.0.0.1:29000
# STT_S3_ACCESS_KEY=stt
# STT_S3_SECRET_KEY=stt123456
# STT_S3_BUCKET_AUDIO=stt-audio
# STT_S3_BUCKET_ARTIFACTS=stt-artifacts
