# Deployment settings for docker compose. `./launch.sh` copies this to .env on
# first run and fills in the two generated secrets.
#
# .env is gitignored: real credentials never belong in git, and the secret
# hygiene test fails the build if they show up there.

# ---- the console's login -------------------------------------------------
STT_UI_USERNAME=stt
# Generated by ./launch.sh (24 random characters). Blank here on purpose: the
# production guard refuses to start rather than run on a known password.
# The login page's demo panel: fills the username, and the password only when
# it is the shipped development default. Forced off in production; set false
# for any deployment other people can reach.
STT_AUTH_DEMO_MODE=true
STT_UI_PASSWORD=
# Signs session cookies. Generated by ./launch.sh; keep it stable across
# restarts or every session is invalidated.
STT_SESSION_SECRET=

# ---- deployment profile --------------------------------------------------
STT_ENVIRONMENT=production
# The local demo is plain HTTP, so the cookie cannot require HTTPS. Behind a
# TLS-terminating proxy set this to true (production does that by default when
# the variable is absent).
STT_SESSION_COOKIE_SECURE=false

# ---- the local model -----------------------------------------------------
# CPU by default: small + int8 runs anywhere, no CUDA needed.
# ./launch.sh gpu switches to large-v3-turbo + float16 on the GPU, using
# STT_WHISPER_MODEL_GPU / STT_COMPUTE_TYPE_GPU — the CPU values below stay
# untouched so the two modes never shadow each other.
STT_WHISPER_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# STT_WHISPER_MODEL_GPU=large-v3-turbo
# STT_COMPUTE_TYPE_GPU=float16
# Uploads shorter than this are transcribed inside the request; longer ones
# (and everything when this is 0) become durable jobs the worker runs.
# STT_MAX_SYNC_DURATION_S=180

# ---- long audio -----------------------------------------------------------
# Longer than this, the local provider decodes the file once, slices it at
# exact sample offsets, transcribes each slice and shifts every slice back
# onto the original timeline. 0 disables chunking.
STT_CHUNK_SECONDS=600

# ---- object storage ------------------------------------------------------
# Development defaults, matching the rustfs service in docker-compose.yml.
# Change both together if this stack is ever exposed beyond localhost.
# STT_S3_ACCESS_KEY=stt
# STT_S3_SECRET_KEY=stt123456

# ---- optional: evaluations → MLflow -------------------------------------
# ./launch.sh mlflow starts the tracking server and flips this on.
# STT_MLFLOW_ENABLED=false

# ---- optional: API keys for programmatic clients ------------------------
# The console signs in with a session; API clients present a key instead.
# Format is "key:tenant" pairs, comma-separated. Keys are never logged.
# STT_AUTH_ENABLED=true
# STT_API_KEYS=demo-key:demo-tenant

# ---- optional: managed providers ----------------------------------------
# A managed provider registers only when its key is present. Nothing is sent
# to a cloud provider unless a request explicitly selects one.
# STT_DEEPGRAM_API_KEY=
# STT_ELEVENLABS_API_KEY=
# STT_SARVAM_API_KEY=
# STT_MANAGED_CONCURRENCY=4

# ---- optional: live streaming (on by default) ---------------------------
# The console streams audio over a WebSocket while you record; the local
# model only, nothing persisted. A deployment that needs different bounds
# sets them here.
# STT_STREAM_MAX_DURATION_S=300      # a session is closed (capped) past this
# STT_STREAM_IDLE_TIMEOUT_S=30       # silence this long ends the session
# STT_STREAM_MAX_SESSIONS=2          # per API process; over that: STREAM_BUSY
# STT_STREAM_MAX_FRAME_BYTES=1048576 # one audio frame may not exceed this

# ---- observability (on by default, never breaks a job) ------------------
# Traces go to an OTLP/HTTP endpoint. Nothing here is required: with no
# collector listening the exports fail quietly and transcription is
# untouched. Read spans straight from the container log with
# STT_OTEL_EXPORTER=console, or turn tracing off with STT_OTEL_ENABLED=false.
# A local collector/UI, if you want one:
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one
# ...then point STT_OTEL_ENDPOINT at an address the containers can reach.
# STT_OTEL_ENABLED=true
# STT_OTEL_EXPORTER=otlp            # otlp | console | none
# STT_OTEL_ENDPOINT=http://127.0.0.1:4318
# STT_LOG_JSON=false
# STT_LOG_LEVEL=INFO
# STT_PROMETHEUS_ENABLED=false
