            ],
            "title": "Model Version"
          },
          "processing_duration_s": {
            "minimum": 0.0,
            "title": "Processing Duration S",
            "type": "number"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/TranscriptSegment"
            },
            "title": "Segments",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "timestamp_granularity": {
            "default": "segment",
            "enum": [
              "segment",
              "word"
            ],
            "title": "Timestamp Granularity",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "text",
          "audio_duration_s",
          "processing_duration_s",
          "provider",
          "model"
        ],
        "title": "TranscriptResult",
        "type": "object"
      },
      "TranscriptSegment": {
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "end": {
            "title": "End",
            "type": "number"
          },
          "speaker": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/TranscriptWord"
            },
            "title": "Words",
            "type": "array"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "title": "TranscriptSegment",
        "type": "object"
      },
      "TranscriptWord": {
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "end": {
            "title": "End",
            "type": "number"
          },
          "speaker": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "title": "TranscriptWord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
