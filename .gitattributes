* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
*.json text eol=lf
# Shell scripts and container files must stay LF on every platform: a CRLF
# shebang or a CRLF line continuation breaks bash and docker build.
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.conf text eol=lf
*.wav binary
*.bin binary
